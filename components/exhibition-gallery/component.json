{
  "id": "exhibition-gallery",
  "version": "1.0.2",
  "tier": "free",
  "name": "Exhibition Gallery",
  "category": "Galleries",
  "description": "A landscape exhibition with spacious image frames, glass captions, category transitions and a full-screen crossfade viewer.",
  "keywords": [
    "exhibition",
    "gallery",
    "masonry",
    "filter",
    "lightbox"
  ],
  "settings": [
    {
      "key": "heading",
      "kind": "text",
      "label": "Gallery title",
      "default": "Light in Motion",
      "group": "Content",
      "maxLength": 100
    },
    {
      "key": "captions",
      "kind": "string-list",
      "label": "Image captions",
      "default": [
        "Sun passage",
        "Coastal light",
        "Blue petals",
        "Warm interval",
        "Rose dunes",
        "Silver grass",
        "Blue hour",
        "City echo",
        "Apricot bloom",
        "Quiet hills",
        "Rose window",
        "Passing light"
      ],
      "group": "Content",
      "minItems": 0,
      "maxItems": 24,
      "maxItemLength": 160
    },
    {
      "key": "categories",
      "kind": "string-list",
      "label": "Display tags",
      "default": [
        "Places",
        "Nature",
        "Nature",
        "People",
        "Nature",
        "Nature",
        "People",
        "People",
        "Nature",
        "Nature",
        "People",
        "Places"
      ],
      "group": "Content",
      "minItems": 0,
      "maxItems": 24,
      "maxItemLength": 40,
      "description": "One displayed tag per image. Filter memberships can be separate."
    },
    {
      "key": "memberships",
      "kind": "string-list",
      "label": "Filter memberships",
      "description": "One comma-separated list per image. A photo may appear under several filters, but only once in the viewer.",
      "default": [
        "Places",
        "Nature",
        "Nature",
        "People",
        "Nature",
        "Nature",
        "People",
        "People",
        "Nature",
        "Nature",
        "People",
        "Places"
      ],
      "group": "Content",
      "minItems": 0,
      "maxItems": 24,
      "maxItemLength": 200
    },
    {
      "key": "imageUrls",
      "kind": "string-list",
      "label": "Custom image URLs",
      "default": [],
      "group": "Content",
      "description": "Empty uses the twelve included worldwide landscape images. Supply matching captions and categories for custom images.",
      "minItems": 0,
      "maxItems": 24,
      "maxItemLength": 2048
    },
    {
      "key": "initialCategory",
      "kind": "text",
      "label": "Initial category",
      "default": "All",
      "group": "Content",
      "maxLength": 40
    },
    {
      "key": "columns",
      "kind": "number",
      "label": "Desktop columns",
      "default": 2,
      "group": "Layout",
      "min": 2,
      "max": 6,
      "step": 1
    },
    {
      "key": "gap",
      "kind": "number",
      "label": "Image gap",
      "default": 24,
      "group": "Layout",
      "min": 4,
      "max": 40,
      "step": 1
    },
    {
      "key": "radius",
      "kind": "number",
      "label": "Corner radius",
      "default": 10,
      "group": "Layout",
      "min": 0,
      "max": 28,
      "step": 1
    },
    {
      "key": "captionMode",
      "kind": "select",
      "label": "Captions",
      "default": "hover",
      "group": "Content",
      "options": [
        "hover",
        "always",
        "hidden"
      ]
    },
    {
      "key": "viewer",
      "kind": "boolean",
      "label": "Image viewer",
      "default": true,
      "group": "Behavior"
    },
    {
      "key": "thumbnails",
      "kind": "boolean",
      "label": "Viewer thumbnails",
      "default": true,
      "group": "Behavior"
    },
    {
      "key": "zoom",
      "kind": "number",
      "label": "Viewer zoom",
      "default": 1.7,
      "group": "Behavior",
      "min": 1.2,
      "max": 3,
      "step": 0.1
    },
    {
      "key": "motion",
      "kind": "boolean",
      "label": "Animate changes",
      "default": true,
      "group": "Behavior"
    },
    {
      "key": "background",
      "kind": "color",
      "label": "Surface",
      "default": "#f5f5f5",
      "group": "Palette"
    },
    {
      "key": "foreground",
      "kind": "color",
      "label": "Text",
      "default": "#242424",
      "group": "Palette"
    },
    {
      "key": "accent",
      "kind": "color",
      "label": "Active filter",
      "default": "#242424",
      "group": "Palette"
    }
  ],
  "targets": [
    "react",
    "html",
    "vanilla"
  ],
  "dependencies": {},
