{
  "id": "alloy-accordion",
  "name": "Relay Accordion",
  "version": "1.0.0",
  "tier": "free",
  "category": "Disclosure",
  "description": "Five workspace connections in black chrome or polished silver.",
  "keywords": [
    "accordion",
    "connections",
    "workspace",
    "icons",
    "spring"
  ],
  "settings": [
    {
      "key": "theme",
      "kind": "select",
      "label": "Theme",
      "group": "Appearance",
      "default": "dark",
      "options": [
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "light",
          "label": "Light"
        }
      ]
    },
    {
      "key": "finish",
      "kind": "select",
      "label": "Icon finish",
      "group": "Appearance",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Match theme"
        },
        {
          "value": "black",
          "label": "Black chrome"
        },
        {
          "value": "silver",
          "label": "Polished silver"
        }
      ]
    },
    {
      "key": "initialItem",
      "label": "Opening panel",
      "kind": "number",
      "default": 3,
      "min": 1,
      "max": 5,
      "step": 1,
      "group": "Panels"
    },
    {
      "key": "autoPlay",
      "label": "Cycle through panels",
      "kind": "boolean",
      "default": true,
      "group": "Motion"
    },
    {
      "key": "interval",
      "label": "Time per panel (s)",
      "kind": "number",
      "default": 5,
      "min": 2,
      "max": 20,
      "step": 0.25,
      "group": "Motion"
    },
    {
      "key": "motionSpeed",
      "label": "Spring speed (×)",
      "kind": "number",
      "default": 1,
      "min": 0.4,
      "max": 2,
      "step": 0.05,
      "group": "Motion"
    },
    {
      "key": "artScale",
      "label": "All icons (×)",
      "kind": "number",
      "default": 1,
      "min": 0.6,
      "max": 1.3,
      "step": 0.01,
      "group": "Artwork"
    },
    {
      "key": "backplateStrength",
      "label": "Backplate strength (%)",
      "kind": "number",
      "default": 65,
      "min": 0,
      "max": 100,
      "step": 1,
      "group": "Artwork"
    },
    {
      "key": "gap",
      "label": "Card spacing (px)",
      "kind": "number",
      "default": 10,
      "min": 0,
      "max": 24,
      "step": 1,
      "group": "Cards"
    },
    {
      "key": "radius",
      "label": "Corner radius (px)",
      "kind": "number",
      "default": 16,
      "min": 0,
      "max": 32,
      "step": 1,
      "group": "Cards"
    },
    {
      "key": "coverColor",
      "label": "Dark bar colour",
      "kind": "color",
      "default": "#1c1c1c",
      "group": "Cards"
    },
    {
      "key": "mailColor",
      "kind": "color",
      "label": "Dark panel colour",
      "default": "#222222",
      "group": "Mail"
    },
    {
      "key": "mailScale",
      "kind": "number",
      "label": "Artwork size (×)",
      "default": 1,
      "min": 0.5,
      "max": 1.5,
      "step": 0.01,
      "group": "Mail"
    },
    {
      "key": "calendarColor",
      "kind": "color",
      "label": "Dark panel colour",
      "default": "#222222",
      "group": "Calendar"
    },
    {
      "key": "calendarScale",
      "kind": "number",
      "label": "Artwork size (×)",
      "default": 1,
      "min": 0.5,
      "max": 1.5,
      "step": 0.01,
      "group": "Calendar"
    },
    {
      "key": "filesColor",
      "kind": "color",
      "label": "Dark panel colour",
      "default": "#222222",
      "group": "Files"
    },
    {
      "key": "filesScale",
      "kind": "number",
      "label": "Artwork size (×)",
      "default": 1,
      "min": 0.5,
      "max": 1.5,
      "step": 0.01,
      "group": "Files"
    },
    {
      "key": "notesColor",
      "kind": "color",
      "label": "Dark panel colour",
      "default": "#222222",
      "group": "Notes"
    },
    {
      "key": "notesScale",
      "kind": "number",
      "label": "Artwork size (×)",
      "default": 1,
      "min": 0.5,
      "max": 1.5,
      "step": 0.01,
      "group": "Notes"
    },
    {
      "key": "chatColor",
      "kind": "color",
      "label": "Dark panel colour",
      "default": "#222222",
      "group": "Chat"
    },
    {
      "key": "chatScale",
      "kind": "number",
      "label": "Artwork size (×)",
      "default": 1,
      "min": 0.5,
      "max": 1.5,
      "step": 0.01,
      "group": "Chat"
    },
    {
      "key": "lightCoverColor",
      "kind": "color",
      "label": "Light bar colour",
      "group": "Cards",
      "default": "#ffffff"
    },
    {
      "key": "maxWidth",
      "kind": "number",
      "label": "Maximum width (px)",
      "group": "Cards",
      "default": 1040,
      "min": 840,
      "max": 1440,
      "step": 10
    },
    {
      "key": "panelHeight",
      "kind": "number",
      "label": "Desktop height (px)",
      "group": "Cards",
      "default": 520,
      "min": 380,
      "max": 720,
      "step": 4
    },
    {
      "key": "padding",
      "kind": "number",
      "label": "Panel padding (px)",
      "group": "Cards",
      "default": 24,
      "min": 12,
      "max": 40,
      "step": 1
    },
    {
      "key": "rim",
      "kind": "number",
      "label": "Edge strength (%)",
      "group": "Cards",
      "default": 8,
      "min": 0,
      "max": 40,
      "step": 1
    },
    {
      "key": "titleSize",
      "kind": "number",
      "label": "Title size (px)",
      "group": "Typography",
      "default": 38,
      "min": 24,
      "max": 48,
      "step": 1
    },
    {
      "key": "bodySize",
      "kind": "number",
      "label": "Description size (px)",
      "group": "Typography",
      "default": 16,
      "min": 13,
      "max": 21,
      "step": 1
    },
    {
      "key": "lineHeight",
      "kind": "number",
      "label": "Description line height",
      "group": "Typography",
      "default": 1.55,
      "min": 1.15,
      "max": 1.9,
      "step": 0.05
    },
    {
      "key": "buttonSize",
      "kind": "number",
      "label": "Control diameter (px)",
      "group": "Controls",
      "default": 32,
      "min": 24,
      "max": 42,
      "step": 1
    },
    {
      "key": "glyphSize",
      "kind": "number",
      "label": "Control icon (px)",
      "group": "Controls",
      "default": 16,
      "min": 12,
      "max": 22,
      "step": 1
    },
    {
      "key": "divider",
      "kind": "number",
      "label": "Link divider strength (%)",
      "group": "Controls",
      "default": 20,
      "min": 0,
      "max": 80,
      "step": 1
    },
    {
      "key": "artShadow",
      "kind": "number",
      "label": "Artwork shadow (%)",
      "group": "Artwork",
      "default": 12,
      "min": 0,
      "max": 60,
      "step": 1
    },
    {
      "key": "hoverMotion",
      "kind": "number",
      "label": "Hover movement (%)",
      "group": "Motion",
      "default": 100,
      "min": 0,
      "max": 150,
      "step": 1
    },
    {
      "key": "hoverDelay",
      "kind": "number",
      "label": "Hover open delay (ms)",
      "group": "Motion",
      "default": 120,
      "min": 0,
      "max": 500,
      "step": 10
