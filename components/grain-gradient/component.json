      }
    },
    {
      "name": "Flowing ribbons",
      "settings": {
        "variant": "ribbons",
        "coreColor": "#FFA504",
        "glowColor": "#FF6414",
        "edgeColor": "#E14236",
        "rimColor": "#8C214C",
        "size": 0.69,
        "softness": 0.56,
        "grain": 0.24,
        "grainScale": 1,
        "speed": 1,
