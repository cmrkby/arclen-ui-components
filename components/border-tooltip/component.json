{
  "id": "border-tooltip",
  "version": "1.0.0",
  "tier": "free",
  "name": "Border Tooltip",
  "category": "Feedback",
  "description": "Fine outlined tooltips with curved, angular and oversized treatments.",
  "keywords": [
    "tooltip",
    "border",
    "information",
    "accessible"
  ],
  "settings": [
    {
      "key": "direction",
      "kind": "select",
      "label": "Design direction",
      "default": "A",
      "options": [
        "A",
        "B",
        "C"
      ],
      "group": "Design"
    },
    {
      "key": "labels",
      "kind": "string-list",
      "label": "Tooltip descriptions",
      "default": [
        "Clues",
        "Notes",
        "Ideas"
      ],
      "minItems": 3,
      "maxItems": 3,
      "maxItemLength": 180,
      "group": "Content"
    },
    {
      "key": "theme",
      "kind": "select",
      "label": "Theme",
      "default": "auto",
      "options": [
        "auto",
        "light",
        "dark"
      ],
      "group": "Appearance"
    },
    {
      "key": "placement",
      "kind": "select",
      "label": "Preferred placement",
      "default": "top",
      "options": [
        "top",
        "bottom",
        "left",
        "right"
      ],
      "group": "Layout"
    },
    {
      "key": "scale",
      "kind": "number",
      "label": "Scale",
      "default": 1,
      "min": 0.75,
      "max": 1.5,
      "step": 0.05,
      "group": "Layout"
    },
    {
      "key": "gap",
      "kind": "number",
      "label": "Pointer distance",
      "default": 12,
      "min": 8,
      "max": 24,
      "step": 1,
      "group": "Layout"
    },
    {
      "key": "duration",
      "kind": "number",
      "label": "Motion duration",
      "default": 400,
      "min": 0,
      "max": 700,
      "step": 10,
      "group": "Motion"
    },
    {
      "key": "accent",
      "kind": "color",
      "label": "Focus accent",
      "default": "#7d8aff",
      "group": "Appearance"
    }
  ],
  "targets": [
    "react",
    "html",
    "vanilla"
  ],
  "dependencies": {},
  "assets": [
    {
      "path": "assets/inter-400-latin.woff2",
      "contentType": "font/woff2",
      "rights": {
        "kind": "licensed",
        "license": "OFL-1.1",
        "attribution": "Inter by Rasmus Andersson. See assets/OFL-Inter.txt."
      }
    },
    {
      "path": "assets/OFL-Inter.txt",
      "contentType": "text/plain",
      "rights": {
        "kind": "licensed",
        "license": "OFL-1.1",
        "attribution": "Inter copyright and SIL Open Font License."
      }
    },
    {
      "path": "NOTICE.md",
      "contentType": "text/markdown",
      "rights": {
        "kind": "original",
        "attribution": "Arclen, 2026. Component authorship and third-party font notice."
      }
    },
    {
      "path": "PROVENANCE.md",
      "contentType": "text/markdown",
      "rights": {
        "kind": "original",
        "attribution": "Arclen, 2026. Component authorship and asset inventory."
      }
    }
  ],
  "poster": "poster.webp",
  "motion": {
    "reducedMotion": "Opacity only; removes translation and scale.",
    "pauseOffscreen": true
  },
  "previews": [
    {
      "name": "Quiet contour",
      "settings": {
        "direction": "A"
      }
    },
    {
      "name": "Folded note",
      "settings": {
        "direction": "B"
      }
    },
    {
      "name": "Margin mark",
      "settings": {
        "direction": "C"
      }
    }
  ]
}
