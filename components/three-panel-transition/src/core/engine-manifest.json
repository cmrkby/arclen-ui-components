{
  "id": "page-transitions",
  "version": "1.0.0",
  "tier": "free",
  "name": "Page Transitions",
  "category": "Transitions",
  "description": "Five distinct page reveals, with adjustable timing and transitions between scenes.",
  "keywords": [
    "page",
    "entrance",
    "navigation",
    "panels",
    "pixels"
  ],
  "settings": [
    {
      "key": "preset",
      "kind": "select",
      "label": "Transition",
      "default": "slats",
      "group": "Motion",
      "options": [
        {
          "label": "Split type",
          "value": "split-type"
        },
        {
          "label": "Three panels",
          "value": "three-panels"
        },
        {
          "label": "Center split",
          "value": "center-split"
        },
        {
          "label": "Staggered slats",
          "value": "slats"
        },
        {
          "label": "Pixel sweep",
          "value": "pixels"
        }
      ]
    },
    {
      "key": "autoplay",
      "kind": "boolean",
      "label": "Play on entry",
      "default": true,
      "group": "Playback"
    },
    {
      "key": "label",
      "kind": "text",
      "label": "Transition label",
      "default": "FRAME",
      "group": "Content",
      "maxLength": 12
    },
    {
      "key": "heading",
      "kind": "text",
      "label": "Heading",
      "default": "Make an\nentrance.",
      "group": "Content",
      "maxLength": 100
    },
    {
      "key": "caption",
      "kind": "text",
      "label": "Caption",
      "default": "Set the tone before the first scroll.\nMake every arrival feel considered.",
      "group": "Content",
      "maxLength": 180
    },
    {
      "key": "background",
      "kind": "color",
      "label": "Canvas",
      "default": "#090909",
      "group": "Palette"
    },
    {
      "key": "foreground",
      "kind": "color",
      "label": "Text",
      "default": "#f4f4f0",
      "group": "Palette"
    },
    {
      "key": "overlayColor",
      "kind": "color",
      "label": "Cover",
      "default": "#0a0a0a",
      "group": "Palette"
    },
    {
      "key": "overlayText",
      "kind": "color",
      "label": "Cover label",
      "default": "#eeeae1",
      "group": "Palette"
    },
    {
      "key": "minHeight",
      "kind": "number",
      "label": "Minimum height",
      "default": 520,
      "group": "Geometry",
      "min": 200,
      "max": 1000,
      "step": 10
    },
    {
      "key": "duration",
      "kind": "number",
      "label": "Reveal duration",
      "default": 2600,
      "group": "Motion",
      "min": 20,
      "max": 5000,
      "step": 10
    },
    {
      "key": "coverDuration",
      "kind": "number",
      "label": "Navigation cover",
      "default": 500,
      "group": "Motion",
      "min": 100,
      "max": 2000,
      "step": 10
    },
    {
      "key": "stagger",
      "kind": "number",
      "label": "Panel / radial step",
      "default": 60,
      "group": "Motion",
      "min": 0,
      "max": 150,
      "step": 1
    },
    {
      "key": "hold",
      "kind": "number",
      "label": "Covered hold",
      "default": 0,
      "group": "Motion",
      "min": 0,
      "max": 2000,
      "step": 10
    },
    {
      "key": "leadIn",
      "kind": "number",
      "label": "Entry delay",
      "default": 0,
      "group": "Motion",
      "min": 0,
      "max": 3000,
      "step": 10
    },
    {
      "key": "sliceDuration",
      "kind": "number",
      "label": "Slice assembly",
      "default": 700,
      "group": "Motion",
      "min": 100,
      "max": 1500,
      "step": 10
    },
    {
      "key": "sliceStagger",
      "kind": "number",
      "label": "Slice stagger",
      "default": 25,
      "group": "Motion",
      "min": 0,
      "max": 100,
      "step": 5
    },
    {
      "key": "glyphStagger",
      "kind": "number",
      "label": "Letter stagger",
      "default": 50,
      "group": "Motion",
      "min": 0,
      "max": 150,
      "step": 5
    },
    {
      "key": "settleDuration",
      "kind": "number",
      "label": "Title settle",
      "default": 1100,
      "group": "Motion",
      "min": 100,
      "max": 2000,
      "step": 10
    },
    {
      "key": "scale",
      "kind": "number",
      "label": "Content starting scale",
      "default": 1.35,
      "group": "Motion",
      "min": 1,
      "max": 1.5,
      "step": 0.01
    },
    {
      "key": "travel",
      "kind": "number",
      "label": "Rise distance",
      "default": 8,
      "group": "Motion",
      "min": 0,
      "max": 48,
      "step": 1
    },
    {
      "key": "slatCount",
      "kind": "number",
      "label": "Number of slats",
      "default": 10,
      "group": "Geometry",
      "min": 4,
      "max": 20,
      "step": 1
    },
    {
      "key": "gridColumns",
      "kind": "number",
      "label": "Grid columns",
      "default": 30,
      "group": "Geometry",
      "min": 8,
      "max": 36,
      "step": 1
    },
    {
      "key": "easing",
      "kind": "select",
      "label": "Motion curve",
      "default": "decay",
      "group": "Motion",
      "options": [
        {
          "label": "Expressive",
          "value": "expressive"
        },
        {
          "label": "Smooth",
          "value": "smooth"
        },
        {
          "label": "Linear",
          "value": "linear"
        },
        {
          "label": "Center split",
          "value": "split"
        },
        {
          "label": "Long decay",
          "value": "decay"
        },
        {
          "label": "Smooth shutter",
          "value": "shutter"
        }
      ]
    },
    {
      "key": "origin",
      "kind": "select",
      "label": "Pixel origin",
      "default": "top-left",
      "group": "Geometry",
      "options": [
        "top-left",
        "top-right",
        "bottom-left",
        "bottom-right"
      ]
    },
    {
      "key": "slatDirection",
      "kind": "select",
      "label": "Slat direction",
      "default": "up",
      "group": "Geometry",
      "options": [
        "up",
        "down"
      ]
    },
    {
      "key": "responsiveSlats",
      "kind": "boolean",
      "label": "Responsive slats",
      "default": true,
      "group": "Geometry",
      "description": "Below 1200px use six downward slats and the compact timing controls."
    },
    {
      "key": "lineDuration",
      "kind": "number",
      "label": "Counter and line sequence",
      "default": 1031,
      "group": "Motion",
      "min": 100,
      "max": 1500,
      "step": 10,
      "description": "Scales the draw, fill and stretch phases together; the counter is aesthetic."
    },
    {
      "key": "gridRows",
      "kind": "number",
      "label": "Grid rows",
      "default": 22,
      "min": 8,
      "max": 30,
      "step": 1,
      "group": "Geometry"
    },
    {
      "key": "textDuration",
      "kind": "number",
      "label": "Copy entrance",
      "default": 1100,
      "min": 100,
      "max": 2500,
      "step": 10,
      "group": "Motion"
    },
    {
      "key": "textTravel",
      "kind": "number",
      "label": "Copy horizontal travel",
      "default": 150,
      "min": 0,
      "max": 300,
      "step": 1,
      "group": "Motion"
    },
    {
      "key": "buttonTravel",
      "kind": "number",
      "label": "Replay vertical travel",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 1,
      "group": "Motion"
    },
    {
      "key": "creditTravel",
      "kind": "number",
      "label": "Credit vertical travel",
      "default": 100,
      "min": 0,
      "max": 200,
      "step": 1,
      "group": "Motion"
    },
    {
      "key": "compactDuration",
      "kind": "number",
      "label": "Compact slat duration",
      "default": 3500,
      "min": 100,
      "max": 5000,
      "step": 10,
      "group": "Motion"
    },
    {
      "key": "compactStagger",
      "kind": "number",
      "label": "Compact slat stagger",
      "default": 90,
      "min": 0,
      "max": 200,
      "step": 5,
      "group": "Motion"
    },
    {
      "key": "titleDelay",
      "kind": "number",
      "label": "Title settle delay",
      "default": 1300,
      "min": 0,
      "max": 3000,
      "step": 10,
      "group": "Motion"
    },
    {
      "key": "titleTravel",
      "kind": "number",
      "label": "Title settle travel",
      "default": 213,
      "min": 0,
      "max": 400,
      "step": 1,
      "group": "Motion"
    },
    {
      "key": "titleScale",
      "kind": "number",
      "label": "Title starting scale",
      "default": 2,
      "min": 1,
      "max": 3,
      "step": 0.05,
      "group": "Motion"
    },
    {
      "key": "panelColor",
      "kind": "color",
      "label": "Shutter cover",
      "default": "#de4912",
      "group": "Palette",
      "description": "Burnt orange sampled from the hero image background."
    },
    {
      "key": "panelText",
      "kind": "color",
      "label": "Shutter mark",
      "default": "#171310",
      "group": "Palette"
    },
    {
      "key": "counterColor",
      "kind": "color",
      "label": "Counter and fill",
      "default": "#dc9058",
      "group": "Palette"
    },
    {
      "key": "panelRadius",
      "kind": "number",
      "label": "Shutter corner radius",
      "default": 6,
      "min": 0,
      "max": 30,
      "step": 1,
      "group": "Geometry"
    },
    {
      "key": "labelTravel",
      "kind": "number",
      "label": "Shutter mark travel",
      "default": 112,
      "min": 0,
      "max": 240,
      "step": 1,
      "group": "Geometry"
    },
    {
      "key": "pixelHeading",
      "kind": "color",
      "label": "Pixel heading",
      "default": "#f4f4f0",
      "group": "Palette"
    },
    {
      "key": "pixelCompactHeading",
      "kind": "color",
      "label": "Pixel compact heading",
      "default": "#f4f4f0",
      "group": "Palette"
    },
    {
      "key": "pixelMobileText",
      "kind": "color",
      "label": "Pixel mobile copy",
      "default": "#fdfdff",
      "group": "Palette"
    },
    {
      "key": "pixelBackdrop",
      "kind": "color",
      "label": "Pixel unrevealed ground",
      "default": "#000000",
      "group": "Palette"
    },
    {
      "key": "imageRise",
      "kind": "number",
      "label": "Image rise",
      "default": 120,
      "group": "Motion",
      "min": 0,
      "max": 240,
      "step": 1,
      "description": "Image starts this many pixels lower and settles behind the opening panels. Set to 0 for a static image."
    },
    {
      "key": "imageDuration",
      "kind": "number",
      "label": "Image settle duration",
      "default": 850,
      "group": "Motion",
      "min": 100,
      "max": 2500,
      "step": 10,
      "description": "Duration of the image rise, in milliseconds."
    },
    {
      "key": "imageDelay",
      "kind": "number",
      "label": "Image start offset",
      "default": 450,
      "group": "Motion",
      "min": 0,
      "max": 2000,
      "step": 10,
      "description": "Milliseconds after the first panel starts moving. Entry delay and covered hold apply before this offset."
    }
  ],
  "targets": [
    "react",
    "html",
    "vanilla"
  ],
  "dependencies": {},
