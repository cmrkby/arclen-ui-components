{
  "id": "cinema-reel",
  "version": "1.0.0",
  "tier": "free",
  "name": "Cinema Reel",
  "category": "Image Slideshows",
  "description": "A cinematic image reel with clickable photographic thumbnails and an overlay or solid footer.",
  "keywords": [
    "slideshow",
    "carousel",
    "images",
    "gallery",
    "react",
    "cinema",
    "thumbnails",
    "filmstrip"
  ],
  "settings": [
    {
      "key": "reelFooter",
      "kind": "select",
      "label": "Footer style",
      "default": "overlay",
      "group": "Composition",
      "options": [
        {
          "label": "Overlay",
          "value": "overlay"
        },
        {
          "label": "Solid",
          "value": "solid"
        }
      ]
    },
    {
      "key": "transition",
      "kind": "select",
      "label": "Transition",
      "default": "blur",
      "group": "Motion",
      "options": [
        {
          "label": "Blur",
          "value": "blur"
        },
        {
          "label": "Fade",
          "value": "fade"
        },
        {
          "label": "Slide",
          "value": "slide"
        },
        {
          "label": "Slide Up",
          "value": "slideUp"
        },
        {
          "label": "Cover",
          "value": "cover"
        },
        {
          "label": "Wipe",
          "value": "wipe"
        },
        {
          "label": "Zoom",
          "value": "zoom"
        },
        {
          "label": "None",
          "value": "none"
        }
      ]
    },
    {
      "key": "images",
      "kind": "string-list",
      "label": "Image URLs or bundled artwork",
      "default": [
        "cinema-coast",
        "cinema-ridge",
        "cinema-tide"
      ],
      "group": "Content",
      "minItems": 1,
      "maxItems": 12,
      "maxItemLength": 2048
    },
    {
      "key": "titles",
      "kind": "string-list",
      "label": "Slide titles",
      "default": [
        "Where land meets sea",
        "Into the mist",
        "The returning tide"
      ],
      "group": "Content",
      "minItems": 0,
      "maxItems": 12,
      "maxItemLength": 100
    },
    {
      "key": "descriptions",
      "kind": "string-list",
      "label": "Slide descriptions",
      "default": [
        "An Atlantic headland in silver light.",
        "Coastal ridges fading into sea mist.",
        "Foam traces the edge of a dark shore."
      ],
      "group": "Content",
      "minItems": 0,
      "maxItems": 12,
      "maxItemLength": 240
    },
    {
      "key": "alts",
      "kind": "string-list",
      "label": "Image descriptions",
      "default": [
        "Dark coastal cliffs above teal Atlantic waves under low mist",
        "Green coastal ridges and pine forests fading into sea mist",
        "Black tidal sand and dark rocks beneath foggy cliffs"
      ],
      "group": "Content",
      "minItems": 0,
      "maxItems": 12,
      "maxItemLength": 200
    },
    {
      "key": "label",
      "kind": "text",
      "label": "Region label",
      "default": "Along the coast",
      "group": "Content",
      "maxLength": 100
    },
    {
      "key": "height",
      "kind": "number",
      "label": "Height",
      "default": 500,
      "group": "Geometry",
      "min": 300,
      "max": 900,
      "step": 10
    },
    {
      "key": "radius",
      "kind": "number",
      "label": "Corner radius",
      "default": 0,
      "group": "Geometry",
      "min": 0,
      "max": 48,
      "step": 1
    },
    {
      "key": "duration",
      "kind": "number",
      "label": "Transition duration",
      "default": 650,
      "group": "Motion",
      "min": 0,
      "max": 1200,
      "step": 10
    },
    {
      "key": "interval",
      "kind": "number",
      "label": "Autoplay interval",
      "default": 5000,
      "group": "Motion",
      "min": 2000,
      "max": 15000,
      "step": 500
    },
    {
      "key": "autoplay",
      "kind": "boolean",
      "label": "Autoplay",
      "default": true,
      "group": "Motion"
    },
    {
      "key": "accent",
      "kind": "color",
      "label": "Accent",
      "default": "#a4b9b1",
      "group": "Appearance"
    },
    {
      "key": "background",
      "kind": "color",
      "label": "Surface",
      "default": "#171717",
      "group": "Appearance"
    },
    {
      "key": "foreground",
      "kind": "color",
      "label": "Text",
      "default": "#ffffff",
      "group": "Appearance"
    },
    {
      "key": "reelSurface",
      "kind": "color",
      "label": "Solid footer surface",
      "default": "#f6f3ed",
      "group": "Appearance"
    },
    {
      "key": "reelText",
      "kind": "color",
      "label": "Solid footer text",
      "default": "#252b25",
      "group": "Appearance"
    },
    {
      "key": "heightMode",
      "kind": "select",
      "label": "Height mode",
      "default": "fill",
      "options": [
        "fixed",
        "fill"
      ],
      "group": "Geometry"
    },
    {
      "key": "imageFit",
      "kind": "select",
      "label": "Image fit",
      "default": "cover",
      "options": [
        "cover",
        "contain"
      ],
      "group": "Image"
    },
    {
      "key": "focalX",
      "kind": "number",
      "label": "Horizontal focal point",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "group": "Image"
    },
    {
      "key": "focalY",
      "kind": "number",
      "label": "Vertical focal point",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "group": "Image"
    },
    {
      "key": "imageScale",
      "kind": "number",
      "label": "Image scale",
      "default": 1,
      "min": 1,
      "max": 1.5,
      "step": 0.05,
      "group": "Image"
    },
    {
      "key": "blurAmount",
      "kind": "number",
      "label": "Blur strength",
      "default": 16,
      "min": 0,
      "max": 40,
      "step": 1,
      "group": "Motion"
    },
    {
      "key": "zoomAmount",
      "kind": "number",
      "label": "Zoom strength",
      "default": 0.18,
      "min": 0.02,
      "max": 0.5,
      "step": 0.01,
      "group": "Motion"
    },
    {
      "key": "showIndicators",
      "kind": "boolean",
      "label": "Thumbnail navigation",
      "default": true,
      "group": "Visibility"
    }
  ],
  "targets": [
    "react",
    "html",
    "vanilla"
  ],
  "dependencies": {},
  "assets": [
    {
      "path": "assets/canyon.svg",
      "contentType": "image/svg+xml",
