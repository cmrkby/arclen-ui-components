      }
    }
  ],
  "poster": "poster.webp",
  "motion": {
    "reducedMotion": "Decorative transitions and automatic progression stop. Manual navigation remains immediate.",
    "pauseOffscreen": true
  },
  "previews": [
    {
      "name": "Default",
      "settings": {}
    },
    {
      "name": "Solid footer",
      "settings": {
        "reelFooter": "solid"
      }
    }
  ]
}
