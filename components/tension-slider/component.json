      "kind": "number",
      "default": 1,
      "min": 0.5,
      "max": 1.35,
      "step": 0.05,
      "group": "Launch"
    },
    {
      "key": "pullLean",
      "label": "Tick lean (×)",
      "kind": "number",
      "default": 1,
      "min": 0,
      "max": 1.6,
      "step": 0.1,
      "group": "Launch"
    },
    {
      "key": "bandWidth",
      "label": "Elastic band width (px)",
      "kind": "number",
      "default": 1.5,
      "min": 0.5,
      "max": 4,
      "step": 0.25,
      "group": "Aim guides"
    },
    {
      "key": "bandOpacity",
      "label": "Elastic band opacity (%)",
      "kind": "number",
      "default": 84,
      "min": 0,
      "max": 100,
      "step": 1,
