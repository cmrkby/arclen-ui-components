    },
    {
      "key": "arcWidth",
      "label": "Guide width (px)",
      "kind": "number",
      "default": 1,
      "min": 0.5,
      "max": 3,
      "step": 0.25,
      "group": "Aim guides"
    },
    {
      "key": "arcOpacity",
      "label": "Guide opacity (%)",
      "kind": "number",
