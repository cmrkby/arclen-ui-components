{
  "id": "ricizen-slideshow",
  "name": "Trackside Slideshow",
  "version": "1.0.0",
  "description": "Two downhill race builds from Rafe Calder × TOR, on the trail and in the studio.",
  "settings": [
    {
      "key": "framing",
      "kind": "select",
      "label": "Stage framing",
      "default": "fit",
      "group": "Appearance",
      "options": [
        {
          "value": "fit",
          "label": "Fit preview"
        },
        {
          "value": "reference",
          "label": "Reference crop"
        }
      ]
    },
    {
      "key": "font",
      "kind": "select",
      "label": "Typeface",
      "default": "inter",
      "group": "Appearance",
      "options": [
        {
          "value": "inter",
          "label": "Inter"
        },
        {
          "value": "geist",
          "label": "Geist Sans"
        }
      ]
    },
    {
      "key": "headlineWeight",
      "kind": "number",
      "label": "Headline weight",
      "default": 620,
      "group": "Appearance",
      "min": 400,
      "max": 900,
      "step": 10
    },
    {
      "key": "accent",
      "kind": "color",
      "label": "Accent colour",
      "default": "#f54e00",
      "group": "Appearance"
    },
    {
      "key": "backplateStrength",
      "kind": "number",
      "label": "Backplate strength (%)",
      "default": 56,
      "group": "Appearance",
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "key": "radius",
      "kind": "number",
      "label": "Stage radius (px)",
      "default": 0,
      "group": "Appearance",
      "min": 0,
      "max": 48,
      "step": 1
    },
    {
      "key": "photoBorder",
      "kind": "number",
      "label": "Photo border opacity (%)",
      "default": 16,
      "group": "Appearance",
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "key": "pillSize",
      "kind": "number",
      "label": "Height (px)",
      "default": 32,
      "group": "Image pill",
      "min": 24,
      "max": 52,
      "step": 1
    },
    {
      "key": "pillRadius",
      "kind": "number",
      "label": "Corner radius (px)",
      "default": 24,
      "group": "Image pill",
      "min": 0,
      "max": 54,
      "step": 1
    },
    {
      "key": "pillShadow",
      "kind": "number",
      "label": "Shadow strength (%)",
      "default": 100,
      "group": "Image pill",
      "min": 0,
      "max": 200,
      "step": 1
    },
    {
      "key": "arrowSize",
      "kind": "number",
      "label": "Size (px)",
      "default": 32,
      "group": "Arrow buttons",
      "min": 24,
      "max": 48,
      "step": 1
    },
    {
      "key": "arrowRadius",
      "kind": "number",
      "label": "Corner radius (px)",
      "default": 24,
      "group": "Arrow buttons",
      "min": 0,
      "max": 54,
      "step": 1
    },
    {
      "key": "arrowShadow",
      "kind": "number",
      "label": "Shadow strength (%)",
      "default": 100,
      "group": "Arrow buttons",
      "min": 0,
      "max": 200,
      "step": 1
    },
    {
      "key": "shellSize",
      "kind": "number",
      "label": "Size (%)",
      "default": 100,
      "group": "Thumbnail shell",
      "min": 70,
      "max": 130,
      "step": 1
    },
    {
      "key": "shellRadius",
      "kind": "number",
      "label": "Corner radius (px)",
      "default": 16,
      "group": "Thumbnail shell",
      "min": 0,
      "max": 54,
      "step": 1
    },
    {
      "key": "shellShadow",
      "kind": "number",
      "label": "Shadow strength (%)",
      "default": 100,
      "group": "Thumbnail shell",
      "min": 0,
      "max": 200,
      "step": 1
    },
    {
      "key": "autoplay",
      "kind": "boolean",
      "label": "Auto-advance",
      "default": true,
      "group": "Motion"
    },
    {
      "key": "interval",
      "kind": "number",
      "label": "Seconds per slide",
      "default": 5,
      "group": "Motion",
      "min": 2,
      "max": 15,
      "step": 0.25
    },
    {
      "key": "marquee",
      "kind": "number",
      "label": "Marquee duration (s)",
      "default": 27,
      "group": "Motion",
      "min": 8,
      "max": 60,
      "step": 1
    },
    {
      "key": "speed",
      "kind": "number",
      "label": "Transition speed (×)",
      "default": 1,
      "group": "Motion",
      "min": 0.5,
      "max": 2,
      "step": 0.05
    },
    {
      "key": "initial",
      "kind": "select",
      "label": "Opening slide",
      "default": "1",
      "group": "Appearance",
      "options": [
        {
          "value": "1",
          "label": "Red Dust / Film"
        },
        {
          "value": "2",
          "label": "Red Dust / Studio"
        },
        {
          "value": "3",
          "label": "Nightfire / Trail"
        },
        {
          "value": "4",
          "label": "Nightfire / Studio"
        }
      ]
    },
