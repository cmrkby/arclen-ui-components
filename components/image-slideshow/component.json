{
  "id": "image-slideshow",
  "version": "1.0.0",
  "tier": "free",
  "name": "Image Slideshow",
  "category": "Image Slideshows",
  "description": "A full-bleed image slideshow with eight transitions, subtle progress bars and arrow navigation.",
  "keywords": [
    "slideshow",
    "carousel",
    "images",
    "gallery",
    "react",
    "full bleed",
    "photography"
  ],
  "settings": [
    {
      "key": "transition",
      "kind": "select",
      "label": "Transition",
      "default": "blur",
      "group": "Motion",
      "options": [
        {
          "label": "Blur",
          "value": "blur"
        },
        {
          "label": "Fade",
          "value": "fade"
        },
        {
          "label": "Slide",
          "value": "slide"
        },
        {
          "label": "Slide Up",
          "value": "slideUp"
        },
        {
          "label": "Cover",
          "value": "cover"
        },
        {
          "label": "Wipe",
          "value": "wipe"
        },
        {
          "label": "Zoom",
          "value": "zoom"
        },
        {
          "label": "None",
          "value": "none"
        }
      ]
    },
    {
      "key": "images",
      "kind": "string-list",
      "label": "Image URLs or bundled artwork",
      "default": [
        "forest-lounge",
        "forest-stair",
        "forest-retreat"
      ],
      "group": "Content",
      "minItems": 1,
      "maxItems": 12,
      "maxItemLength": 2048
    },
    {
      "key": "titles",
      "kind": "string-list",
      "label": "Slide titles",
      "default": [
        "Built around nature",
        "Space to slow down",
        "A quieter retreat"
      ],
      "group": "Content",
      "minItems": 0,
      "maxItems": 12,
      "maxItemLength": 100
    },
    {
      "key": "descriptions",
      "kind": "string-list",
      "label": "Slide descriptions",
      "default": [
        "Stone, glass and a living forest canopy.",
        "Warm timber beneath tall forest windows.",
        "A sheltered room against the rock."
      ],
      "group": "Content",
      "minItems": 0,
      "maxItems": 12,
      "maxItemLength": 240
    },
    {
      "key": "alts",
      "kind": "string-list",
      "label": "Image descriptions",
      "default": [
        "Dark forest lounge with a mossy rock wall, glass roof and warm walnut furniture",
        "Charcoal stone staircase and sunken lounge framed by tall forest windows",
        "Walnut platform bed beside an exposed rock wall under a glass roof"
      ],
      "group": "Content",
      "minItems": 0,
      "maxItems": 12,
      "maxItemLength": 200
    },
    {
      "key": "label",
      "kind": "text",
      "label": "Region label",
      "default": "A forest retreat",
      "group": "Content",
      "maxLength": 100
    },
    {
      "key": "height",
      "kind": "number",
      "label": "Height",
      "default": 500,
      "group": "Geometry",
      "min": 300,
      "max": 900,
      "step": 10
    },
    {
      "key": "radius",
      "kind": "number",
      "label": "Corner radius",
      "default": 0,
      "group": "Geometry",
      "min": 0,
      "max": 48,
      "step": 1
    },
    {
      "key": "duration",
      "kind": "number",
      "label": "Transition duration",
      "default": 650,
      "group": "Motion",
      "min": 0,
      "max": 1200,
      "step": 10
    },
    {
      "key": "interval",
      "kind": "number",
      "label": "Autoplay interval",
      "default": 5000,
      "group": "Motion",
      "min": 2000,
      "max": 15000,
      "step": 500
    },
    {
      "key": "autoplay",
      "kind": "boolean",
      "label": "Autoplay",
      "default": true,
      "group": "Motion"
    },
    {
      "key": "accent",
      "kind": "color",
      "label": "Accent",
      "default": "#a7b291",
      "group": "Appearance"
    },
    {
      "key": "background",
      "kind": "color",
      "label": "Surface",
      "default": "#171717",
      "group": "Appearance"
    },
    {
      "key": "foreground",
      "kind": "color",
      "label": "Text",
      "default": "#ffffff",
      "group": "Appearance"
    },
    {
      "key": "heightMode",
      "kind": "select",
      "label": "Height mode",
      "default": "fill",
      "options": [
        "fixed",
        "fill"
      ],
      "group": "Geometry"
    },
    {
      "key": "imageFit",
      "kind": "select",
      "label": "Image fit",
      "default": "cover",
      "options": [
        "cover",
        "contain"
      ],
      "group": "Image"
    },
    {
      "key": "focalX",
      "kind": "number",
      "label": "Horizontal focal point",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "group": "Image"
    },
    {
      "key": "focalY",
      "kind": "number",
      "label": "Vertical focal point",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "group": "Image"
    },
    {
      "key": "imageScale",
      "kind": "number",
      "label": "Image scale",
      "default": 1,
      "min": 1,
      "max": 1.5,
      "step": 0.05,
      "group": "Image"
    },
    {
      "key": "blurAmount",
      "kind": "number",
      "label": "Blur strength",
      "default": 16,
      "min": 0,
      "max": 40,
      "step": 1,
      "group": "Motion"
    },
    {
      "key": "zoomAmount",
      "kind": "number",
      "label": "Zoom strength",
      "default": 0.18,
      "min": 0.02,
      "max": 0.5,
      "step": 0.01,
      "group": "Motion"
    },
    {
      "key": "showCaptions",
      "kind": "boolean",
      "label": "Overlay captions",
      "default": false,
      "group": "Visibility"
    },
    {
      "key": "showNavigation",
      "kind": "boolean",
      "label": "Navigation arrows",
      "default": true,
      "group": "Visibility"
    },
    {
      "key": "showIndicators",
      "kind": "boolean",
      "label": "Slide indicators",
      "default": true,
      "group": "Visibility"
    }
  ],
  "targets": [
    "react",
    "html",
    "vanilla"
  ],
  "dependencies": {},
  "assets": [
    {
