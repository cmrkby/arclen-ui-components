  "targets": [
    "react",
    "html",
    "vanilla"
  ],
  "dependencies": {},
  "assets": [
    {
      "path": "poster.webp",
      "rights": {
        "kind": "original",
        "attribution": "Arclen UI",
        "license": "MIT"
      }
    }
  ],
  "poster": "poster.webp",
  "motion": {
    "reducedMotion": "Static readable frame; no continuous animation.",
    "pauseOffscreen": true
  }
}
