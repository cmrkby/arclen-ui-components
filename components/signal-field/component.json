      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.25,
      "group": "Field"
    },
    {
      "kind": "number",
      "key": "glyphRadius",
      "label": "Glyph radius",
      "min": 0.05,
      "max": 1,
      "step": 0.01,
      "default": 0.24,
      "group": "Field"
    },
    {
      "key": "frameRate",
      "label": "frameRate",
      "kind": "number",
      "min": 1,
      "max": 60,
      "step": 1,
      "default": 60,
      "group": "Field"
    },
    {
      "key": "resolutionScale",
      "label": "resolutionScale",
      "kind": "number",
      "min": 0.25,
      "max": 1,
      "step": 0.05,
      "default": 0.85,
      "group": "Field"
    },
    {
      "key": "glyphs",
      "label": "glyphs",
      "kind": "text",
      "default": " .:+*oO#",
      "group": "Field"
    }
