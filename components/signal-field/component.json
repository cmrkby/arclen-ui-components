{
  "id": "signal-field",
  "version": "2.0.1",
  "tier": "free",
  "name": "Signal Field",
  "category": "Backgrounds",
  "description": "A pointer-responsive WebGL field with editable colour, motion and grain.",
  "keywords": [
    "background",
    "shader",
    "webgl",
    "interactive"
  ],
  "previews": [
    {
      "name": "Original",
      "settings": {
        "showText": true
      }
    },
    {
      "name": "ASCII lens",
      "settings": {
        "interaction": "ascii-lens",
        "showText": true
      }
    },
    {
      "name": "Orange",
      "settings": {
        "baseColor": "#181511",
        "surfaceColor": "#211c18",
        "accentColor": "#d57630",
        "secondaryAccentColor": "#ffb159",
        "showText": true
      }
    }
  ],
  "settings": [
    {
      "kind": "select",
      "key": "interaction",
      "label": "Interaction",
      "options": [
        {
          "value": "classic",
          "label": "Classic"
        },
        {
          "value": "ascii-lens",
          "label": "ASCII lens"
        }
      ],
      "default": "classic",
      "group": "Field"
    },
    {
      "kind": "number",
      "key": "asciiSize",
      "label": "ASCII cell size",
      "min": 6,
      "max": 32,
      "step": 1,
      "default": 14,
      "group": "Field"
    },
    {
      "kind": "number",
      "key": "asciiStrength",
      "label": "ASCII strength",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 1,
      "group": "Field"
    },
    {
      "kind": "number",
      "key": "asciiSoftness",
      "label": "Lens softness",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.65,
      "group": "Field"
    },
    {
      "kind": "color",
      "key": "baseColor",
      "label": "Base colour",
      "default": "#f4efe5",
      "group": "Colours"
    },
    {
      "kind": "color",
      "key": "surfaceColor",
      "label": "Surface colour",
      "default": "#f2eee6",
      "group": "Colours"
    },
    {
      "kind": "color",
      "key": "accentColor",
