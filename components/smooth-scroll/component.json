      }
    },
    {
      "path": "assets/OFL-Inter.txt",
      "contentType": "text/plain",
      "rights": {
        "kind": "licensed",
        "license": "OFL-1.1",
        "attribution": "Inter copyright and SIL Open Font License."
      }
    }
  ],
  "poster": "poster.webp",
  "motion": {
    "reducedMotion": "Native scrolling and instant return to top; no animated travel.",
    "pauseOffscreen": true
  },
  "previews": [
    {
      "name": "Calm",
      "settings": {}
    }
  ]
}
