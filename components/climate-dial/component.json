    {
      "key": "lightTop",
      "kind": "color",
      "label": "Light face highlight",
      "group": "Face",
      "default": "#fdfcfa"
    },
    {
      "key": "lightMid",
      "kind": "color",
      "label": "Light face midtone",
      "group": "Face",
      "default": "#f6f4f0"
    },
    {
      "key": "lightBase",
      "kind": "color",
      "label": "Light face shadow",
      "group": "Face",
      "default": "#efece7"
    },
    {
      "key": "darkTop",
      "kind": "color",
      "label": "Dark face highlight",
      "group": "Face",
      "default": "#161616"
    },
    {
      "key": "darkMid",
      "kind": "color",
      "label": "Dark face midtone",
      "group": "Face",
      "default": "#0b0b0b"
    },
