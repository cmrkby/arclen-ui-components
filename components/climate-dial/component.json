{
  "id": "climate-dial",
  "version": "1.0.0",
  "tier": "free",
  "name": "Climate Dial",
  "category": "Controls",
  "description": "A radial temperature control with a calibrated scale and a seasonal readout.",
  "keywords": [
    "temperature",
    "climate",
    "dial",
    "slider",
    "radial"
  ],
  "settings": [
    {
      "key": "theme",
      "kind": "select",
      "label": "Theme",
      "default": "light",
      "options": [
        "dark",
        "light"
      ],
      "group": "Face"
    },
    {
      "key": "value",
      "kind": "number",
      "label": "Temperature (°C)",
      "default": 38,
      "min": -9,
      "max": 70,
      "step": 1,
      "group": "Interaction"
    },
    {
      "key": "hint",
      "kind": "boolean",
      "label": "Show interaction hint",
      "default": true,
      "group": "Hint"
    },
    {
      "key": "size",
      "kind": "number",
      "label": "Dial width",
      "group": "Face",
      "default": 340,
      "min": 240,
      "max": 460,
      "step": 2
    },
    {
      "key": "glow",
      "kind": "number",
      "label": "Thermal glow",
      "group": "Floor glow",
      "default": 1,
      "min": 0,
      "max": 2,
      "step": 0.05
    },
    {
      "key": "coldAccent",
      "kind": "color",
      "label": "Cold accent",
      "group": "Thermal palette",
      "default": "#3b82f6"
    },
    {
      "key": "warmAccent",
      "kind": "color",
      "label": "Warm accent",
      "group": "Thermal palette",
      "default": "#ff3d1a"
    },
    {
      "key": "spring",
      "kind": "number",
      "label": "Spring rebound",
      "group": "Motion",
      "default": 0.55,
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    {
      "key": "speed",
      "kind": "number",
      "label": "Response speed",
      "group": "Motion",
      "default": 1,
      "min": 0.4,
      "max": 2,
      "step": 0.05
    },
    {
      "key": "entrance",
      "kind": "boolean",
      "label": "Play entrance sweep",
      "group": "Entrance",
      "default": true
    },
    {
      "key": "pulse",
      "kind": "boolean",
      "label": "Pulse bottom glow",
      "group": "Floor glow",
      "default": true
    },
    {
      "key": "pulsePeriod",
      "kind": "number",
      "label": "Pulse cycle (seconds)",
      "group": "Floor glow",
      "default": 3.81,
      "min": 1.2,
      "max": 8,
      "step": 0.01
    },
    {
      "key": "pulseDepth",
      "kind": "number",
      "label": "Pulse depth (%)",
      "group": "Floor glow",
      "default": 1.5,
      "min": 0,
      "max": 85,
      "step": 0.5
    },
    {
      "key": "bloomWidth",
      "kind": "number",
      "label": "Glow spread (%)",
      "group": "Floor glow",
      "default": 84,
      "min": 45,
      "max": 120,
      "step": 1
    },
    {
      "key": "showSeason",
      "kind": "boolean",
      "label": "Show season name",
      "group": "Season label",
      "default": true
    },
    {
      "key": "faceRadius",
      "kind": "number",
      "label": "Corner radius (% of width)",
      "group": "Face",
      "default": 30,
      "min": 0,
      "max": 50,
      "step": 1
