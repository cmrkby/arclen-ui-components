    {
      "path": "assets/inter-400-latin-ext.woff2",
      "rights": {
        "kind": "licensed",
        "license": "OFL-1.1",
        "attribution": "The Inter Project Authors. See assets/OFL-Inter.txt."
      }
    },
    {
      "path": "assets/OFL-Inter.txt",
      "rights": {
        "kind": "licensed",
        "license": "OFL-1.1",
        "attribution": "The Inter Project Authors. See assets/OFL-Inter.txt."
      }
    },
    {
      "path": "LICENSE",
      "rights": {
        "kind": "licensed",
        "license": "MIT",
