      }
    },
    {
      "path": "poster.webp",
      "rights": {
        "kind": "original",
        "attribution": "Captured from the working Growing Navigation component."
      }
    }
  ],
  "poster": "poster.webp",
  "motion": {
    "reducedMotion": "Open, close and hover changes settle immediately; navigation and focus remain available.",
    "pauseOffscreen": true
  },
  "previews": [
    {
      "name": "Growing Navigation",
      "settings": {}
    }
  ]
}
