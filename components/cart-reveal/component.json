{
  "id": "cart-reveal",
  "version": "1.1.0",
  "tier": "free",
  "name": "Cart Reveal",
  "category": "Commerce",
  "description": "A product tile with an expandable cart, live subtotal and slide-to-confirm control.",
  "keywords": [
    "cart",
    "product",
    "quantity",
    "subtotal",
    "slider"
  ],
  "settings": [
    {
      "key": "theme",
      "kind": "select",
      "label": "Card finish",
      "group": "Card frame",
      "default": "dark",
      "options": [
        "dark",
        "light"
      ]
    },
    {
      "key": "title",
      "kind": "text",
      "label": "Product name",
      "default": "Relay Trail 01",
      "maxLength": 90,
      "group": "Content"
    },
    {
      "key": "brand",
      "kind": "text",
      "label": "Brand",
      "default": "Arclen Footwear",
      "maxLength": 60,
      "group": "Content"
    },
    {
      "key": "price",
      "kind": "number",
      "label": "Unit price (USD)",
      "default": 59,
      "min": 0,
      "max": 100000,
      "step": 0.01,
      "group": "Content"
    },
    {
      "key": "image",
      "kind": "text",
      "label": "Product image URL or path",
      "default": "",
      "maxLength": 12000000,
      "group": "Content"
    },
    {
      "key": "confirmLabel",
      "kind": "text",
      "label": "Confirmation button text",
      "group": "Confirmation track",
      "default": "Slide to confirm",
      "maxLength": 44
    },
    {
      "key": "receiptText",
      "kind": "text",
      "label": "Receipt message",
      "group": "Receipt",
      "default": "Confirmed",
      "maxLength": 64
    },
    {
      "key": "showWishlist",
      "kind": "boolean",
      "label": "Show wishlist button",
      "group": "Wishlist",
      "default": true
    },
    {
      "key": "sound",
      "kind": "boolean",
      "label": "Play confirmation tone",
      "default": false,
      "group": "Receipt"
    },
    {
      "key": "radius",
      "kind": "number",
      "label": "Card corner radius",
      "group": "Card frame",
      "default": 34,
      "min": 6,
      "max": 56,
      "step": 1
    },
    {
      "key": "accent",
      "kind": "color",
      "label": "Cart accent",
      "group": "Quantity controls",
      "default": "#e0182d"
    },
    {
      "key": "foldSpeed",
      "kind": "number",
