{
  "id": "quick-find",
  "version": "1.0.0",
  "tier": "free",
  "name": "Quick Find",
  "category": "Search",
  "description": "An expandable workspace search with local results, category filters, and removable recent items.",
  "keywords": [
    "search",
    "command",
    "filter",
    "keyboard",
    "recent"
  ],
  "settings": [
    {
      "key": "theme",
      "kind": "select",
      "label": "Theme",
      "default": "light",
      "options": [
        {
          "label": "Light",
          "value": "light"
        },
        {
          "label": "Dark",
          "value": "dark"
        }
      ],
      "group": "Appearance"
    },
    {
      "key": "corner",
      "kind": "number",
      "label": "Corner radius",
      "default": 12,
      "min": 0,
      "max": 40,
      "step": 1,
      "group": "Appearance"
    },
    {
      "key": "rows",
      "kind": "number",
      "label": "Recent rows",
      "default": 3,
      "min": 0,
      "max": 4,
      "step": 1,
      "group": "Results"
    },
    {
      "key": "shortcut",
      "kind": "boolean",
      "label": "Keyboard shortcut",
      "default": true,
      "group": "Interaction"
    },
    {
      "key": "rowHeight",
      "kind": "number",
      "label": "Row height (px)",
      "default": 68,
      "min": 56,
      "max": 84,
      "step": 1,
      "group": "Results"
    },
    {
      "key": "openWidth",
      "kind": "number",
      "label": "Open width (px)",
      "default": 420,
      "min": 320,
      "max": 600,
      "step": 1,
      "group": "Appearance"
    },
    {
      "key": "openDuration",
      "kind": "number",
      "label": "Open duration (ms)",
      "default": 560,
      "min": 220,
      "max": 800,
      "step": 5,
      "group": "Motion"
    },
    {
      "key": "hoverDuration",
      "kind": "number",
      "label": "Hover response (ms)",
      "default": 240,
      "min": 120,
      "max": 500,
      "step": 5,
      "group": "Motion"
    },
    {
      "key": "accent",
      "kind": "color",
      "label": "Accent",
      "default": "#f54e00",
      "group": "Appearance"
    },
    {
      "key": "showArtwork",
      "kind": "boolean",
      "label": "Result artwork",
      "default": true,
      "group": "Results"
    },
    {
      "key": "placeholder",
      "kind": "text",
      "label": "Field placeholder",
      "default": "Find in workspace…",
      "maxLength": 80,
      "group": "Content"
    },
    {
      "key": "thumbnailSize",
      "kind": "number",
      "label": "Thumbnail size (px)",
      "default": 44,
      "min": 24,
      "max": 48,
      "step": 1,
      "group": "Results"
    },
    {
      "key": "showDescriptions",
      "kind": "boolean",
      "label": "Show result descriptions",
      "default": true,
      "group": "Results"
    },
    {
      "key": "noResultsText",
      "kind": "text",
      "label": "No matches message",
      "default": "No matching items",
      "maxLength": 140,
      "group": "Content"
    },
    {
      "key": "emptyRecentsText",
      "kind": "text",
      "label": "Empty recents message",
      "default": "No recent items",
      "maxLength": 140,
      "group": "Content"
    },
    {
      "key": "showDividers",
      "kind": "boolean",
      "label": "Result dividers",
      "default": true,
      "group": "Results"
    },
    {
      "key": "chipGap",
      "kind": "number",
      "label": "Pill spacing (px)",
      "default": 14,
      "min": 0,
      "max": 28,
      "step": 1,
      "group": "Category strip"
    },
    {
      "key": "edgeFade",
      "kind": "number",
      "label": "Edge fade width (px)",
      "default": 48,
      "min": 0,
      "max": 80,
      "step": 1,
      "group": "Category strip"
    },
    {
      "key": "hoverTint",
      "kind": "number",
      "label": "Hover tint strength (%)",
      "default": 10,
      "min": 0,
      "max": 32,
      "step": 1,
      "group": "Results"
    },
    {
      "key": "closedWidth",
      "kind": "number",
      "label": "Closed width (px)",
      "default": 300,
      "group": "Search field",
      "min": 200,
      "max": 420,
      "step": 1
    },
    {
      "key": "fieldHeight",
      "kind": "number",
      "label": "Field height (px)",
      "default": 50,
      "group": "Search field",
      "min": 44,
      "max": 72,
      "step": 1
    },
    {
      "key": "fieldInset",
      "kind": "number",
      "label": "Left padding (px)",
      "default": 16,
      "group": "Search field",
      "min": 6,
      "max": 28,
      "step": 1
    },
    {
      "key": "fieldGap",
      "kind": "number",
      "label": "Icon to input gap (px)",
      "default": 10,
      "group": "Search field",
      "min": 2,
      "max": 24,
      "step": 1
    },
    {
      "key": "fieldTextSize",
      "kind": "number",
      "label": "Input type size (px)",
      "default": 15,
      "group": "Search field",
      "min": 12,
      "max": 21,
      "step": 0.5
    },
    {
      "key": "searchIconSize",
      "kind": "number",
      "label": "Search icon size (px)",
      "default": 24,
      "group": "Search field",
      "min": 14,
      "max": 32,
      "step": 1
    },
    {
      "key": "closeSize",
      "kind": "number",
      "label": "Close button size (px)",
      "default": 30,
      "group": "Search field",
      "min": 24,
      "max": 40,
      "step": 1
    },
    {
      "key": "closeIconSize",
      "kind": "number",
      "label": "Close icon size (px)",
      "default": 16,
      "group": "Search field",
      "min": 12,
      "max": 22,
      "step": 1
    },
    {
      "key": "shortcutRadius",
      "kind": "number",
      "label": "Shortcut radius (px)",
      "default": 6,
      "group": "Search field",
      "min": 0,
      "max": 11,
      "step": 1
    },
    {
      "key": "sheetInset",
      "kind": "number",
      "label": "Sheet inset (px)",
      "default": 6,
      "group": "Results panel",
      "min": 0,
      "max": 18,
      "step": 1
    },
    {
      "key": "headerHeight",
      "kind": "number",
      "label": "Heading height (px)",
      "default": 40,
      "group": "Results panel",
      "min": 32,
      "max": 64,
      "step": 1
    },
    {
      "key": "headingSize",
      "kind": "number",
      "label": "Heading type size (px)",
      "default": 12.5,
      "group": "Results panel",
      "min": 10,
      "max": 18,
      "step": 0.5
    },
    {
      "key": "rowInset",
      "kind": "number",
      "label": "Result left inset (px)",
      "default": 16,
      "group": "Results panel",
      "min": 4,
      "max": 40,
      "step": 1
    },
    {
      "key": "artworkGap",
      "kind": "number",
      "label": "Artwork to title gap (px)",
      "default": 13,
      "group": "Results panel",
      "min": 2,
      "max": 26,
      "step": 1
    },
    {
      "key": "dividerInset",
      "kind": "number",
      "label": "Divider inset (px)",
      "default": 16,
      "group": "Results panel",
      "min": 0,
      "max": 40,
      "step": 1
    },
    {
      "key": "resultTitleSize",
      "kind": "number",
      "label": "Title size (px)",
      "default": 14.5,
      "group": "Results panel",
      "min": 11,
      "max": 20,
      "step": 0.5
    },
    {
      "key": "resultTitleWeight",
      "kind": "number",
      "label": "Title weight",
      "default": 550,
      "group": "Results panel",
      "min": 400,
      "max": 750,
      "step": 10
    },
    {
      "key": "descriptionSize",
      "kind": "number",
      "label": "Description size (px)",
      "default": 13,
      "group": "Results panel",
      "min": 10,
      "max": 17,
      "step": 0.5
    },
    {
      "key": "textGap",
      "kind": "number",
      "label": "Title to description gap (px)",
      "default": 2,
      "group": "Results panel",
      "min": 0,
      "max": 9,
      "step": 1
    },
    {
      "key": "highlightRadius",
      "kind": "number",
      "label": "Highlight radius (px)",
      "default": 0,
      "group": "Hover and removal",
      "min": 0,
      "max": 24,
      "step": 1
    },
    {
      "key": "artworkHoverScale",
      "kind": "number",
      "label": "Artwork hover scale (×)",
      "default": 1.05,
      "group": "Hover and removal",
      "min": 1,
      "max": 1.3,
      "step": 0.01
    },
    {
      "key": "trashSize",
      "kind": "number",
      "label": "Trash icon size (px)",
      "default": 19,
      "group": "Hover and removal",
      "min": 12,
      "max": 26,
      "step": 1
    },
    {
      "key": "trashButtonSize",
      "kind": "number",
      "label": "Trash button size (px)",
      "default": 32,
      "group": "Hover and removal",
      "min": 26,
      "max": 44,
      "step": 1
    },
    {
      "key": "hoverDamping",
      "kind": "number",
      "label": "Highlight spring damping",
      "default": 0.925,
      "group": "Hover and removal",
      "min": 0.55,
      "max": 1.3,
      "step": 0.005
    },
    {
      "key": "stripHeight",
      "kind": "number",
      "label": "Strip height (px)",
      "default": 64,
