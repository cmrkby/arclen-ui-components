      "default": true,
      "group": "Interaction"
    },
    {
      "key": "iconStroke",
      "kind": "number",
      "label": "Icon stroke (px)",
      "default": 2,
      "min": 1,
      "max": 3,
      "step": 0.1,
      "group": "Search field"
    }
