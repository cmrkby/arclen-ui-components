    },
    {
      "key": "chipRadius",
      "kind": "number",
      "label": "Pill radius (px)",
      "default": 24,
      "group": "Category strip",
      "min": 0,
      "max": 24,
      "step": 1
    },
    {
      "key": "chipTextSize",
      "kind": "number",
      "label": "Pill type size (px)",
      "default": 12,
      "group": "Category strip",
      "min": 10,
      "max": 17,
      "step": 0.5
    },
    {
