      "default": "#000000",
      "group": "Light palette"
    },
    {
      "key": "darkAction",
      "kind": "color",
      "label": "Active icon and clear action",
      "default": "#ffffff",
      "group": "Dark palette"
    },
    {
      "key": "dismissOnOutside",
      "kind": "boolean",
