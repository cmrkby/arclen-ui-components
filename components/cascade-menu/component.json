{
  "id": "cascade-menu",
  "version": "1.0.1",
  "tier": "free",
  "name": "Cascade Menu",
  "category": "Navigation",
  "description": "A sculpted radial navigation menu with eight editable actions, a moving light and keyboard support.",
  "keywords": ["navigation", "radial menu", "cascade", "interaction"],
  "settings": [
    {"key":"theme","kind":"select","label":"Theme","group":"Appearance","default":"system","options":["system","light","dark"]},
    {"key":"lightWheel","kind":"color","label":"Wheel","group":"Light palette","default":"#2f3034"},
    {"key":"lightCenter","kind":"color","label":"Center button","group":"Light palette","default":"#e7e7e7"},
    {"key":"lightIdle","kind":"color","label":"Idle icons","group":"Light palette","default":"#c5c6ca"},
    {"key":"lightActive","kind":"color","label":"Active icon","group":"Light palette","default":"#ffffff"},
    {"key":"lightGlyph","kind":"color","label":"Center glyph","group":"Light palette","default":"#2f3034"},
    {"key":"lightBeam","kind":"color","label":"Moving light","group":"Light palette","default":"#ffffff"},
    {"key":"lightBrand","kind":"color","label":"Brand mark","group":"Light palette","default":"#ff5a1f"},
    {"key":"lightCaptionBackground","kind":"color","label":"Caption background","group":"Light palette","default":"#2f3034"},
    {"key":"lightCaptionText","kind":"color","label":"Caption text","group":"Light palette","default":"#ffffff"},
    {"key":"lightFocus","kind":"color","label":"Focus outline","group":"Light palette","default":"#ff975e"},
    {"key":"lightRing","kind":"color","label":"Ring edge","group":"Light palette","default":"#2f3035"},
    {"key":"darkWheel","kind":"color","label":"Wheel","group":"Dark palette","default":"#262626"},
    {"key":"darkCenter","kind":"color","label":"Center button","group":"Dark palette","default":"#262626"},
    {"key":"darkIdle","kind":"color","label":"Idle icons","group":"Dark palette","default":"#a3a3a3"},
    {"key":"darkActive","kind":"color","label":"Active icon","group":"Dark palette","default":"#ffffff"},
    {"key":"darkGlyph","kind":"color","label":"Center glyph","group":"Dark palette","default":"#ffffff"},
    {"key":"darkBeam","kind":"color","label":"Moving light","group":"Dark palette","default":"#ffffff"},
    {"key":"darkBrand","kind":"color","label":"Brand mark","group":"Dark palette","default":"#ff5a1f"},
    {"key":"darkCaptionBackground","kind":"color","label":"Caption background","group":"Dark palette","default":"#262626"},
    {"key":"darkCaptionText","kind":"color","label":"Caption text","group":"Dark palette","default":"#ffffff"},
    {"key":"darkFocus","kind":"color","label":"Focus outline","group":"Dark palette","default":"#ff975e"},
    {"key":"darkRing","kind":"color","label":"Ring edge","group":"Dark palette","default":"#2f3035"},
    {"key":"reveal","kind":"select","label":"Reveal","group":"Motion","default":"everyday","options":[{"label":"Everyday","value":"everyday"},{"label":"Cascade","value":"original"},{"label":"Quick","value":"quick"},{"label":"Instant items","value":"instant"}]},
    {"key":"labelMode","kind":"select","label":"Labels","group":"Appearance","default":"hover","options":["hover","always","hidden"]},
    {"key":"itemLabels","kind":"string-list","label":"Action labels","group":"Content","default":["Home","Back","Profile","Notes","Chat","Mail","Forward","Phone"],"minItems":8,"maxItems":8,"maxItemLength":80},
    {"key":"itemUrls","kind":"string-list","label":"Action URLs","group":"Content","default":["","","","","","","",""],"minItems":8,"maxItems":8,"maxItemLength":300,"description":"Leave blank to emit an action event without navigating."},
    {"key":"initialOpen","kind":"boolean","label":"Initially open","group":"State","default":true},
    {"key":"activeIndex","kind":"number","label":"Active action","group":"State","default":3,"min":0,"max":7,"step":1},
    {"key":"currentIndex","kind":"number","label":"Current page (-1 hides marker)","group":"State","default":-1,"min":-1,"max":7,"step":1},
    {"key":"rotation","kind":"number","label":"Rotation","group":"Layout","default":0,"min":-360,"max":360,"step":1},
    {"key":"duration","kind":"number","label":"Motion duration","group":"Motion","default":0.4,"min":0,"max":2,"step":0.05},
    {"key":"bounce","kind":"number","label":"Bounce","group":"Motion","default":0.2,"min":0.01,"max":0.8,"step":0.01},
    {"key":"lightStrength","kind":"number","label":"Light strength","group":"Appearance","default":0.2,"min":0,"max":1,"step":0.05},
    {"key":"closeOnSelect","kind":"boolean","label":"Close after selection","group":"Behavior","default":false},
    {"key":"outsideClose","kind":"boolean","label":"Close on outside press","group":"Behavior","default":false}
  ],
  "targets": ["react", "html", "vanilla"],
  "dependencies": {},
  "assets": [
    {"path":"assets/arclen-favicon.svg","rights":{"kind":"original","attribution":"Original Arclen logo."},"contentType":"image/svg+xml"},
    {"path":"assets/NOTICE.md","rights":{"kind":"original","attribution":"Arclen UI implementation and provenance notice."},"contentType":"text/markdown"}
  ],
  "poster":"poster.webp",
  "motion":{"reducedMotion":"Settle the wheel and light immediately while preserving all keyboard actions.","pauseOffscreen":true},
  "previews":[
    {"name":"Everyday","settings":{}},
    {"name":"Cascade reveal","settings":{"reveal":"original"}},
    {"name":"Quick reveal","settings":{"reveal":"quick"}},
    {"name":"Light","settings":{"theme":"light"}},
    {"name":"Dark","settings":{"theme":"dark"}},
    {"name":"Current page","settings":{"currentIndex":3}}
  ]
}
