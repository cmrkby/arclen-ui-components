      "kind": "number",
      "default": 32,
      "min": 0,
      "max": 1000,
      "step": 1,
      "group": "Surface"
    },
    {
      "key": "specularStrength",
      "label": "Specular Strength",
      "kind": "number",
      "default": 0.65,
      "min": 0,
      "max": 3,
      "step": 0.01,
      "group": "Surface"
    },
    {
      "key": "caption",
      "label": "Caption",
      "kind": "text",
      "default": "White water draws a line across volcanic sand.",
      "group": "Content"
    },
    {
      "key": "showRing",
      "label": "Show play mark",
      "kind": "boolean",
      "default": true,
      "group": "Content"
    }
