      "default": 0.15,
      "min": 0,
      "max": 0.6,
      "step": 0.01,
      "group": "Surface"
    },
    {
      "key": "edgeHighlight",
      "label": "Edge Highlight",
      "kind": "number",
      "default": 0.22,
      "min": 0,
      "max": 2,
      "step": 0.01,
      "group": "Surface"
    },
    {
      "key": "edgeDarkening",
      "label": "Edge Darkening",
      "kind": "number",
      "default": 0.22,
      "min": 0,
      "max": 2,
      "step": 0.01,
      "group": "Surface"
    },
    {
      "key": "tintOpacity",
      "label": "Tint Opacity",
      "kind": "number",
      "default": 0.015,
      "min": 0,
      "max": 0.4,
      "step": 0.005,
      "group": "Surface"
    },
    {
      "key": "glassOpacity",
      "label": "Glass Opacity",
      "kind": "number",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "group": "Surface"
    },
    {
      "key": "borderRadius",
