{
  "id": "liquid-glass",
  "version": "1.0.0",
  "tier": "free",
  "name": "Tidal Glass",
  "category": "Backgrounds",
  "description": "A refractive glass lens over a looping wave, with a sharp caption and adjustable optics.",
  "keywords": [
    "glass",
    "refraction",
    "video",
    "lens"
  ],
  "settings": [
    {
      "key": "scene",
      "label": "Backplate",
      "group": "Scene",
      "kind": "select",
      "default": "tidal",
      "options": [
        {
          "label": "Tidal Fold",
          "value": "tidal"
        },
        {
          "label": "Iris Drift",
          "value": "iris"
        },
        {
          "label": "Salt Meadow",
          "value": "salt"
        },
        {
          "label": "Velodrome",
          "value": "velodrome"
        }
      ]
    },
    {
      "key": "playbackSpeed",
      "label": "Playback speed (×)",
      "kind": "number",
      "default": 1,
      "min": 0.25,
      "max": 2,
      "step": 0.05,
      "group": "Motion"
    },
    {
      "key": "refraction",
      "label": "Refraction",
      "kind": "number",
      "default": 0.161,
      "min": 0,
      "max": 0.25,
      "step": 0.001,
      "group": "Lens"
    },
    {
      "key": "edgeRefraction",
