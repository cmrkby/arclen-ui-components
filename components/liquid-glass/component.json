    {
      "key": "magnify",
      "label": "Magnify",
      "kind": "number",
      "default": 1.372,
      "min": 0.6,
      "max": 2,
      "step": 0.001,
      "group": "Lens"
    },
    {
      "key": "dispersion",
      "label": "Dispersion",
      "kind": "number",
      "default": 0.44,
      "min": 0,
      "max": 3,
      "step": 0.01,
      "group": "Lens"
    },
    {
      "key": "bevelDepth",
      "label": "Bevel Depth",
      "kind": "number",
      "default": 0.41,
      "min": 0,
      "max": 1.5,
