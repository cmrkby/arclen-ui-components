{
  "id": "text-bloom",
  "name": "Inline Diorama",
  "version": "1.0.0",
  "description": "The second glass, told by the agent. Hover, focus or tap a photograph to expand it.",
  "settings": [
    {
      "key": "copy",
      "kind": "text",
      "label": "Paragraph",
      "default": "Mara let me watch her hand. I copied the angle of every finger. You can’t see pressure, as it turns out. The crack was mine. I gave my successor softer fingertips. It worked out how to teach the next one by touch. We still use the second glass.",
      "group": "Appearance"
    },
    {
      "key": "background",
      "kind": "color",
      "label": "Background",
      "default": "#000000",
      "group": "Appearance"
    },
    {
      "key": "ink",
